{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipes",
  "type": "object",
  "properties": {
    "change": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/RecipeChangeEntry"
      }
    },
    "recipe": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/RecipeEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RecipeChangeEntry": {
      "description": "A change of vanilla recipes' values.",
      "type": "object",
      "properties": {
        "cost": {
          "description": "How many of each ingredient it takes, 1 to 65535.",
          "anyOf": [
            {
              "$ref": "#/$defs/ValueEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "ingredients": {
          "description": "How many of each named ingredient it takes, 0 to 65535: 0 takes the\ningredient out, and one the recipe lacks is added.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ValueEntry"
          }
        },
        "kind": {
          "description": "Every vanilla recipe whose output is of these kinds:\n`building-block`, `roof`, `overgrowth`, `terrain` or `other`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "output": {
          "description": "Every vanilla recipe that makes one of these items.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "output_count": {
          "description": "How many of each item the recipe makes, 1 to 65535.",
          "anyOf": [
            {
              "$ref": "#/$defs/ValueEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipes": {
          "description": "The recipes changed: GUIDs, content ids or vanilla debug names.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "time": {
          "description": "How long it takes, in seconds from 0 to 86400.",
          "anyOf": [
            {
              "$ref": "#/$defs/ValueEntry"
            },
            {
              "type": "null"
            }
          ]
        },
        "workshop": {
          "description": "Every vanilla recipe made at these crafting stations, named by their\nitems.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "RecipeEntry": {
      "type": "object",
      "properties": {
        "cost": {
          "description": "The copied ingredient counts times this; 1 when left out.",
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "count": {
          "description": "How many it makes; 1 when left out.",
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "id": {
          "description": "The recipe's name in the pack.",
          "type": "string"
        },
        "like": {
          "description": "The item whose recipe is copied.",
          "type": "string"
        },
        "output": {
          "description": "The item it makes.",
          "type": "string"
        },
        "workshop": {
          "description": "Where it is made: a workshop of the pack, or a workshop's GUID or\ncontent id; the copied recipe's when left out.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "like",
        "output"
      ]
    },
    "ScaleEntry": {
      "type": "object",
      "properties": {
        "times": {
          "description": "The factor, from 0 to 100.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "times"
      ]
    },
    "ValueEntry": {
      "description": "A new value: a number sets it, `{ times = x }` scales it.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "$ref": "#/$defs/ScaleEntry"
        }
      ]
    }
  }
}