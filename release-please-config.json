{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": false,
  "always-update": true,
  "release-as": "1.0.0",
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "enshwick",
      "components": [
        "enshwick-loader",
        "enshwick-loader-stub",
        "enshwick-loader-api",
        "enshwick-loader-macros",
        "enshwick-loader-reflect",
        "enshwick-loader-builds",
        "cargo-enshwick"
      ],
      "merge": false
    }
  ],
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "refactor",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Other",
      "hidden": true
    }
  ],
  "packages": {
    "crates/cargo-enshwick": {
      "package-name": "cargo-enshwick",
      "component": "cargo-enshwick"
    },
    "crates/enshwick-loader-api": {
      "package-name": "enshwick-loader-api",
      "component": "enshwick-loader-api",
      "extra-files": [
        {
          "type": "generic",
          "path": "/Cargo.toml"
        }
      ]
    },
    "crates/internal/loader": {
      "package-name": "enshwick-loader",
      "component": "enshwick-loader"
    },
    "crates/internal/stub": {
      "package-name": "enshwick-loader-stub",
      "component": "enshwick-loader-stub"
    },
    "mods/enshwick-flame-altar-count": {
      "package-name": "enshwick-flame-altar-count",
      "component": "enshwick-flame-altar-count"
    },
    "mods/enshwick-flame-altar-zones": {
      "package-name": "enshwick-flame-altar-zones",
      "component": "enshwick-flame-altar-zones"
    },
    "mods/enshwick-survivors-per-altar": {
      "package-name": "enshwick-survivors-per-altar",
      "component": "enshwick-survivors-per-altar"
    },
    "mods/enshwick-furniture-comfort": {
      "package-name": "enshwick-furniture-comfort",
      "component": "enshwick-furniture-comfort"
    },
    "crates/internal/macros": {
      "package-name": "enshwick-loader-macros",
      "component": "enshwick-loader-macros"
    },
    "crates/internal/reflect": {
      "package-name": "enshwick-loader-reflect",
      "component": "enshwick-loader-reflect"
    },
    "crates/internal/builds": {
      "package-name": "enshwick-loader-builds",
      "component": "enshwick-loader-builds"
    },
    "mods/enshwick-safes": {
      "package-name": "enshwick-safes",
      "component": "enshwick-safes"
    },
    "mods/enshwick-building-materials": {
      "package-name": "enshwick-building-materials",
      "component": "enshwick-building-materials"
    },
    "mods/enshwick-area-loot": {
      "package-name": "enshwick-area-loot",
      "component": "enshwick-area-loot"
    },
    "mods/enshwick-build-camera": {
      "package-name": "enshwick-build-camera",
      "component": "enshwick-build-camera"
    },
    "mods/enshwick-shared-experience": {
      "package-name": "enshwick-shared-experience",
      "component": "enshwick-shared-experience"
    },
    "mods/enshwick-admin-tools": {
      "package-name": "enshwick-admin-tools",
      "component": "enshwick-admin-tools"
    },
    "mods/enshwick-optimizer": {
      "package-name": "enshwick-optimizer",
      "component": "enshwick-optimizer"
    }
  }
}
