{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": false,
  "always-update": true,
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    }
  ],
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "refactor",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Other",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Other",
      "hidden": true
    }
  ],
  "packages": {
    "crates/cargo-enshwick": {
      "package-name": "cargo-enshwick",
      "component": "cargo-enshwick"
    },
    "crates/enshwick-api": {
      "package-name": "enshwick-api",
      "component": "enshwick-api"
    },
    "crates/enshwick-loader": {
      "package-name": "enshwick-loader",
      "component": "enshwick-loader"
    },
    "crates/enshwick-stub": {
      "package-name": "enshwick-stub",
      "component": "enshwick-stub"
    },
    "mods/enshwick-flame-altar-count": {
      "package-name": "enshwick-flame-altar-count",
      "component": "enshwick-flame-altar-count"
    },
    "mods/enshwick-flame-altar-zones": {
      "package-name": "enshwick-flame-altar-zones",
      "component": "enshwick-flame-altar-zones"
    },
    "mods/enshwick-survivors-per-altar": {
      "package-name": "enshwick-survivors-per-altar",
      "component": "enshwick-survivors-per-altar"
    },
    "mods/enshwick-furniture-comfort": {
      "package-name": "enshwick-furniture-comfort",
      "component": "enshwick-furniture-comfort"
    },
    "crates/enshwick-macros": {
      "package-name": "enshwick-macros",
      "component": "enshwick-macros"
    },
    "mods/enshwick-safes": {
      "package-name": "enshwick-safes",
      "component": "enshwick-safes"
    },
    "mods/enshwick-building-materials": {
      "package-name": "enshwick-building-materials",
      "component": "enshwick-building-materials"
    },
    "mods/enshwick-area-loot": {
      "package-name": "enshwick-area-loot",
      "component": "enshwick-area-loot"
    },
    "crates/enshwick-test": {
      "package-name": "enshwick-test",
      "component": "enshwick-test"
    },
    "mods/enshwick-updater": {
      "package-name": "enshwick-updater",
      "component": "enshwick-updater"
    },
    "mods/enshwick-build-camera": {
      "package-name": "enshwick-build-camera",
      "component": "enshwick-build-camera"
    },
    "mods/enshwick-shared-experience": {
      "package-name": "enshwick-shared-experience",
      "component": "enshwick-shared-experience"
    },
    "mods/enshwick-dev-tools": {
      "package-name": "enshwick-dev-tools",
      "component": "enshwick-dev-tools"
    },
    "mods/enshwick-proton-optimizer": {
      "package-name": "enshwick-proton-optimizer",
      "component": "enshwick-proton-optimizer"
    }
  }
}
