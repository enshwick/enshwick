---
source: crates/enshwick/tests/pack_schemas.rs
expression: schema
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackManifest",
  "description": "A pack folder's `pack.toml`: what the loader reads before it runs the\npack, as a mod's [`manifest!`](crate::manifest) says it for a DLL.\n\n# Examples\n\n```\nuse enshwick::packs::{PackManifest, PackSide};\n\nlet manifest = PackManifest::parse(r#\"\nid = \"you.lanterns\"\nversion = \"1.0.0\"\nname = \"Lanterns\"\n\n[requires]\nsafes = \">=0.5, <1.0\"\n\"#)?;\nassert_eq!(manifest.id, \"you.lanterns\");\nassert_eq!(manifest.side, PackSide::Both);\nassert!(manifest.join);\nassert_eq!(manifest.requires[\"safes\"], \">=0.5, <1.0\");\n# Ok::<(), enshwick::packs::PackError>(())\n```",
  "type": "object",
  "properties": {
    "authors": {
      "description": "The authors' names.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "description": {
      "description": "One sentence on what it adds.",
      "type": "string",
      "default": ""
    },
    "homepage": {
      "description": "Where players read about it, an `https://` address.",
      "type": "string",
      "default": ""
    },
    "id": {
      "description": "The pack id, `<author>.<name>` like a mod's; it names the folder, the\nnamespace of the pack's content and its texts override file.",
      "type": "string"
    },
    "join": {
      "description": "Whether server and clients must run the same pack, files and all, to\nplay together; on unless the pack says otherwise.",
      "type": "boolean",
      "default": true
    },
    "license": {
      "description": "An SPDX licence expression.",
      "type": "string",
      "default": ""
    },
    "name": {
      "description": "The name players read; the id when empty.",
      "type": "string",
      "default": ""
    },
    "requires": {
      "description": "Mods and packs it needs, by id, each with a Cargo-style version\nrequirement (empty for any).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "side": {
      "description": "Where it runs.",
      "$ref": "#/$defs/PackSide"
    },
    "version": {
      "description": "Its SemVer version.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "version"
  ],
  "$defs": {
    "PackSide": {
      "description": "Where a pack runs, in `pack.toml`.\n\n# Examples\n\nSee [`PackManifest`].",
      "oneOf": [
        {
          "description": "The server and the clients: the default, as both read content.",
          "type": "string",
          "const": "both"
        },
        {
          "description": "The dedicated server and hosting clients only, such as a pack of\nloot alone.",
          "type": "string",
          "const": "server"
        },
        {
          "description": "Clients only.",
          "type": "string",
          "const": "client"
        }
      ]
    }
  }
}
