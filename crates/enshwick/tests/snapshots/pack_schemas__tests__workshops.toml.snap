      "properties": {
        "debug_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "like": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationRecipeEntry"
