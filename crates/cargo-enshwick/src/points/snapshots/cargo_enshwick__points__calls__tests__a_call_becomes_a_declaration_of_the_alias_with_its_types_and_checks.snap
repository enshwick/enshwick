//! What you.trading-post 1.2.0 offers other mods, by the alias `trading_post`.
//!
//! Written by `cargo enshwick deps trading_post`. Write it again for a newer
//! you.trading-post rather than edit it; the checks hold each declaration to the
//! owner's layout. `enshwick::deps!()` makes it `deps::trading_post`.

/// What the trading post pays for an item.
#[enshwick::call(name = "price-of", of = trading_post, output = u32, version = 2)]
#[derive(Clone, Copy, Debug)]
pub struct PriceOf {
    /// The item.
    pub item: u32,
    /// The `deal` of the input.
    pub deal: Deal,
}

const _: () = {
    assert!(
        <PriceOf as enshwick::services::Call>::LAYOUT[0].hash == 0x0000_0000_0000_0001,
        "`item` differs from the server's",
    );
    assert!(
        <PriceOf as enshwick::services::Call>::LAYOUT[1].hash == 0x0000_0000_0000_0002,
        "`deal` differs from the server's",
    );
    assert!(
        <PriceOf as enshwick::services::Call>::OUTPUT[0].hash == 0x0000_0000_0000_0011,
        "the answer differs from the server's",
    );
    assert!(
        size_of::<PriceOf>() == 8,
        "the input's size differs from the server's"
    );
};

/// How the item changes hands.
#[repr(u8)]
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, enshwick::Shape)]
pub enum Deal {
    /// `Buy`, as `you.trading-post` names it.
    Buy = 0,
    /// `Sell`, as `you.trading-post` names it.
    Sell = 1,
}
