//! {description}.

use std::sync::atomic::{AtomicBool, Ordering};

use enshwick::{Load, Mod, Off};

// The keys of `src/texts.toml`, a table per language; the settings' labels
// among them.
enshwick::texts!();

/// Whether the mod does its work now; each world's settings set it.
static ENABLED: AtomicBool = AtomicBool::new(true);

/// The settings, in each world's `<stem>-mod-settings/{id}/settings.toml`.
#[enshwick::config]
#[derive(Debug)]
struct Settings {
    /// Whether the mod does its work.
    // For numbers `range = 1..=10`, for lists of values `choices = [..]`.
    enabled: bool,
}

impl Default for Settings {
    fn default() -> Self {
        Self { enabled: true }
    }
}

/// The mod's state.
#[derive(Debug)]
pub struct {type};

impl Mod for {type} {
    fn init(load: &mut Load<'_>) -> Result<Self, Off> {
        load.texts()?;
        // Defaults now, each world's values as it loads.
        load.on_settings(|settings: &Settings| {
            ENABLED.store(settings.enabled, Ordering::Relaxed);
        })?;
        Ok(Self)
    }
}

enshwick::declare_mod!({type});

#[cfg(test)]
mod tests {
    use enshwick::abi::Status;
    use enshwick::i18n::Texts;

    use super::*;

    #[test]
    fn every_text_exists_in_all_languages() {
        let texts = Texts::parse(texts::TOML).unwrap();
        assert_eq!(texts.untranslated(), []);
    }

    #[test]
    fn runs_on_the_settings_of_the_world_that_loads() {
        let loader = enshwick::test::FakeHost::new()
            .settings("enabled = false\n")
            .install();
        // SAFETY: the exports of `declare_mod!` above.
        let status = unsafe { loader.start(enshwick_mod_init, enshwick_mod_ready) };
        assert_eq!(status, Status::OK);
        assert!(ENABLED.load(Ordering::Relaxed), "the defaults before a world");
        assert_eq!(loader.raise::<enshwick::events::SettingsReplaced>(&()), 1);
        assert!(!ENABLED.load(Ordering::Relaxed));
    }
}
